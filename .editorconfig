# The indentation each language already uses here; C and C++ formatting
# beyond that is .clang-format's (tool/format.sh).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,rs,kt,kts,java}]
indent_size = 4

[{Makefile,*.mk,*.pbxproj}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
